[
  {
    "manifestVersion": 1,
    "id": "spotify-charts",
    "name": "Spotify charts",
    "description": "Spotify's weekly global top songs and albums, plus daily and weekly top songs for any country (via kworb.net). Plays each one through your plugins.",
    "version": "1.2.1",
    "type": "chart",
    "code": "spotify-charts.js",
    "hosts": ["charts-spotify-com-service.spotify.com", "kworb.net", "open.spotify.com"],
    "layout": "cards",
    "categories": [
      { "id": "global-songs", "name": "Top songs (global, weekly)" },
      { "id": "global-albums", "name": "Top albums (global, weekly)" },
      { "id": "country-daily", "name": "Top songs today" },
      { "id": "country-weekly", "name": "Top songs this week" }
    ],
    "region": { "option": "country", "worldwide": true, "categories": ["country-daily", "country-weekly"] },
    "options": {
      "country": {
        "type": "string",
        "label": "Country",
        "description": "Two-letter code for the daily/weekly charts, e.g. us, gb, in; blank for global",
        "default": ""
      }
    }
  },
