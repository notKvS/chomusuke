{
  "name": "chomusuke",
  "version": "0.1.0",
  "description": "Desktop music player that streams audio straight from torrents",
  "author": {
    "name": "notKvS"
  },
  "homepage": "https://github.com/notKvS/chomusuke",
  "repository": {
    "type": "git",
    "url": "https://github.com/notKvS/chomusuke.git"
  },
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "setup": "node node_modules/electron/install.js && cd node_modules/node-datachannel && prebuild-install -r napi",
    "dev": "npm run build:extensions && electron-vite dev",
    "build": "npm run build:extensions && electron-vite build",
    "start": "npm run build:extensions && electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.extensions.json",
    "test": "node --disable-warning=ExperimentalWarning --test \"src/**/*.test.ts\" \"extensions/test/*.test.ts\"",
    "build:extensions": "node --disable-warning=ExperimentalWarning extensions/build.ts",
    "lint": "biome check .",
    "fix": "biome check --write .",
    "format": "biome format --write .",
    "dist": "npm run build && electron-builder",
    "dist:dir": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "fast-xml-parser": "5.11.2",
    "parse-torrent": "11.0.24",
    "webtorrent": "3.0.21"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@fontsource/m-plus-rounded-1c": "5.3.0",
    "@fontsource/nunito": "5.3.0",
    "@semantic-release/exec": "7.1.0",
    "@types/node": "24.19.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/webtorrent": "3.0.0",
    "@vitejs/plugin-react": "5.2.0",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "electron": "44.6.0",
    "electron-builder": "26.17.0",
    "electron-vite": "5.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "semantic-release": "25.0.9",
    "semver": "7.8.5",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
